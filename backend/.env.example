# ─── BACKEND ────────────────────────────────────────────────────────
# No Railway, configure estas variáveis no serviço de BACKEND.

# Banco PostgreSQL. No Railway, referencie o serviço Postgres:
#   DATABASE_URL = ${{ Postgres.DATABASE_URL }}
# Localmente, cole a "Connection URL" pública do Postgres do Railway.
DATABASE_URL="postgresql://usuario:senha@host:5432/railway"

# Segurança dos tokens de login (JWT). Use um valor longo e aleatório.
JWT_SECRET="0c81d7b13327f127157f864a3cc5e0bac8c528eb84b9aba3611b2db78880ec34"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# URL pública do FRONTEND (libera o CORS). Ex: https://alma-church.up.railway.app
FRONTEND_URL="https://SEU-FRONTEND.up.railway.app"

# PORT é injetada automaticamente pelo Railway — não precisa definir.
# NODE_ENV=production
